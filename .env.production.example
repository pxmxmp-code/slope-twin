# 生产环境 PostgreSQL 用户名；仅在 Compose 生产网络内部使用。
POSTGRES_USER=slope_twin
# 生产环境 PostgreSQL 数据库名；数据保存在 ./data/production/postgres。
POSTGRES_DB=slope_twin
# 生产环境数据库密码；必须是独立强密码，勿提交真实值。
POSTGRES_PASSWORD=replace-with-a-strong-production-password
# FastAPI 访问 Compose 内部数据库；主机名必须为 db，端口固定为 5432。
DATABASE_URL=postgresql://slope_twin:replace-with-a-strong-production-password@db:5432/slope_twin
# 容器访问主机上的 GeoServer；若改为远端服务，请填写完整 WMS 地址。
GEOSERVER_WMS_URL=http://host.docker.internal:8080/geoserver/ne/wms
