# 开发环境 PostgreSQL 用户名；仅在 Compose 开发网络内部使用。
POSTGRES_USER=slope_twin
# 开发环境 PostgreSQL 数据库名；数据保存在 ./data/development/postgres。
POSTGRES_DB=slope_twin
# 开发环境数据库密码；必须使用与生产环境不同的强密码，勿提交真实值。
POSTGRES_PASSWORD=replace-with-a-strong-development-password
# FastAPI 访问 Compose 内部数据库；主机名必须为 db，端口固定为 5432。
DATABASE_URL=postgresql://slope_twin:replace-with-a-strong-development-password@db:5432/slope_twin
# 容器访问 Windows/WSL 主机上的 GeoServer；Docker Desktop 可解析 host.docker.internal。
GEOSERVER_WMS_URL=http://host.docker.internal:8080/geoserver/ne/wms
# 允许访问开发前端的主机名，逗号分隔；不含协议和端口。
DEV_ALLOWED_ORIGINS=localhost,127.0.0.1,192.168.1.114
