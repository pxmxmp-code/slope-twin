# ==============================================================================
# Slope Twin 统一环境配置文件
# 服务器局域网 IP: 192.168.1.110
#
# 使用方式：
# 1. 局域网其他电脑开发：直接复制本文件为 .env 即可，无需在本地安装数据库与存储，
#    前端与后端开发将直接使用 192.168.1.110 服务器上已部署就绪的 PostGIS、MinIO、GeoServer 等数据服务。
# 2. 服务器本机 Docker Compose 运行：默认配置开箱即用（docker compose up -d）。
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. 地图令牌与空间范围
# ------------------------------------------------------------------------------
# Mapbox GL JS 二维底图公共令牌（请填入 pk. 开头的公共 token）
MAPBOX_TOKEN=

# 天地图 Web 端应用 Key（请填入天地图 Web 端应用 key）
TIANDITU_TOKEN=

# 麻甲底村斜坡 DOM 空间经纬度范围 [西, 南, 东, 北]
DOM_BOUNDS=[98.87636822220345,27.04721825778342,98.8879329074003,27.05324393689146]


# ------------------------------------------------------------------------------
# 2. 局域网其他电脑开发配置（Client LAN Development）
# ------------------------------------------------------------------------------
# 局域网数据服务器主机 IP
SERVER_HOST=192.168.1.110

# 前端开发（apps/web 运行 npm run dev 时）反向代理的后端 API 地址：
# Next.js 会自动将 /api/* 与 /tiles/* 转发到服务器的 FastAPI
BACKEND_URL=http://192.168.1.110:8000

# 后端开发（apps/api 本地运行时）直连服务器数据库：
# DATABASE_URL=postgresql://slope_twin:slope_twin_password@192.168.1.110:25432/slope_twin

# 后端开发直连服务器 GeoServer WMS：
# GEOSERVER_WMS_URL=http://192.168.1.110:8080/geoserver/ne/wms

# 3D Tiles 瓦片地址（留空或保持 /tiles/tileset.json 时通过后端代理；也可直接指定 MinIO 地址）：
# TILESET_URL=http://192.168.1.110:29000/slope-twin/tiles/tileset.json
TILESET_URL=/tiles/tileset.json


# ------------------------------------------------------------------------------
# 3. 服务器 Docker Compose 部署配置（Server Host Deployment）
# ------------------------------------------------------------------------------
# 服务映射端口（与宿主机其他项目隔离）
POSTGRES_PORT=25432
API_PORT=8000
WEB_PORT=23002
MINIO_PORT=29000
MINIO_CONSOLE_PORT=29001

# PostgreSQL / PostGIS 17 凭据与连接
POSTGRES_USER=slope_twin
POSTGRES_PASSWORD=slope_twin_password
POSTGRES_DB=slope_twin
# 在 Docker Compose 容器内运行时连接容器网络 db:5432：
DATABASE_URL=postgresql://slope_twin:slope_twin_password@db:5432/slope_twin

# GeoServer 配置（Docker 容器访问宿主机原生安装的 GeoServer 8080）
GEOSERVER_WMS_URL=http://host.docker.internal:8080/geoserver/ne/wms
GEOSERVER_DOM_LAYER=ne:DOM_COG

# MinIO 对象存储配置（数据持久化在 ./data/minio）
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
MINIO_BUCKET=slope-twin
# 容器内后端访问 MinIO 内部端点
MINIO_ENDPOINT=http://minio:9000

# 本地瓦片备用目录（若本地无文件，系统将自动从 MinIO 对象存储流式拉取并支持 Range 切片）
TILES_DIRECTORY=data/TILES
