# Browser-visible map keys
MAPBOX_TOKEN=
TIANDITU_TOKEN=

# Local Web -> local API. Docker Compose overrides this with http://api:8000.
BACKEND_URL=http://127.0.0.1:8000

# Local API and deployed API -> infrastructure server
DATABASE_URL=postgresql://slope_twin:slope_twin_password@192.168.1.110:25432/slope_twin
GEOSERVER_WMS_URL=http://192.168.1.110:8080/geoserver/ne/wms
GEOSERVER_WFS_URL=http://192.168.1.110:8080/geoserver/ne/wfs
GEOSERVER_DOM_LAYER=ne:DOM_COG
GEOSERVER_CONTOUR_LAYER=ne:majiadi_contours
# 地质云 WMS 完整地址（含 tk）；令牌过期后需在 .env 中更新
GEOCLOUD_WMS_URL=
GEOCLOUD_WMS_LAYERS=t0,t1,t2,t3,t4,t5,t6,t7,t8,t9,t10,t11,t12
MINIO_ENDPOINT=http://192.168.1.110:29000
MINIO_BUCKET=slope-twin

# Project extent: west,south,east,north
DOM_BOUNDS=[98.87636822220345,27.04721825778342,98.8879329074003,27.05324393689146]

# Final deployment ports
WEB_PORT=23002
API_PORT=8000
